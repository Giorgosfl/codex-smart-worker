{
  "mcpServers": {
    "smart-worker": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "TYPESAFE_API_KEY",
        "DEEPSEEK_API_KEY",
        "CODEX_HOME"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 600
    }
  }
}
